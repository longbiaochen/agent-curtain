#!/bin/zsh
# curtain —— 熄灭所有屏幕并阻断物理键鼠，同时保持解锁会话和远程运维。
set -u
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH

BLOCKER=$HOME/.local/libexec/hid-blocker
BANNER=$HOME/.local/libexec/curtain-banner
WATCHER=$HOME/.local/libexec/curtain-watchdog
SENTRY=$HOME/.local/libexec/curtain-sentry
CONF=$HOME/.config/curtain/allowlist
DENY=$HOME/.config/curtain/denylist
STATE=$HOME/.local/state/curtain
PIDF=$STATE/blocker.pid
LOG=$STATE/blocker.log
LUMF=$STATE/brightness.bak
BANPID=$STATE/banner.pid
WATCHLOG=$STATE/watchdog.log
LASTRUN=$STATE/last-run
EXPECT=$STATE/expected
MANIFEST=$STATE/manifest
JOB_BLOCKER=me.longbiaochen.curtain-blocker
JOB_BANNER=me.longbiaochen.curtain-banner
JOB_WATCHER=me.longbiaochen.curtain-watchdog
JOB_SENTRY=me.longbiaochen.curtain-sentry
BD=betterdisplaycli
mkdir -p $STATE

usage() {
  print -u2 "用法: curtain {on [秒] [--allow-any-injected]|off|status|doctor|allow|deny}"
}

# 当前调用链有没有辅助功能授权。
# TCC 把授权归责到**责任进程**(见 README 5.4),而 python3 和 hid-blocker 一样是
# 本 shell 的子进程,归责结果完全相同 —— 所以这是对 `on` 能否成功的准确预检,
# 且不会像直接跑 hid-blocker 那样弹系统对话框。
ax_trusted() {
  python3 - <<'AXPY' 2>/dev/null
import ctypes, ctypes.util, sys
lib = ctypes.CDLL(ctypes.util.find_library("ApplicationServices"))
lib.AXIsProcessTrusted.restype = ctypes.c_bool
sys.exit(0 if lib.AXIsProcessTrusted() else 1)
AXPY
}

# 打印本进程到 launchd 的祖先链。TCC 认的是这条链上最外层的那个 .app。
responsible_chain() {
  local pid=$$ line ppid
  repeat 8; do
    line=$(ps -o pid=,ppid=,comm= -p "$pid" 2>/dev/null) || break
    [[ -n "$line" ]] || break
    print -r -- "    $line"
    ppid=$(print -r -- "$line" | awk '{print $2}')
    [[ -n "$ppid" && "$ppid" != 1 ]] || break
    pid=$ppid
  done
}

# 轮转而非截断 —— 上一轮是怎么结束的,是排查时最需要的东西。
rotate_log() {
  local file=$1
  [[ -s "$file" ]] && mv -f "$file" "$file.1"
  : > "$file"
}

record_run() {
  print -r -- "$(date '+%F %T') $*" >> "$LASTRUN"
  if [[ -s "$LASTRUN" ]]; then
    tail -n 50 "$LASTRUN" > "$LASTRUN.tmp" && mv -f "$LASTRUN.tmp" "$LASTRUN"
  fi
}

adhoc_signed() { codesign -dvv "$1" 2>&1 | grep -q '^Signature=adhoc' }

job_pid() {
  launchctl print "gui/$(id -u)/$1" 2>/dev/null |
    awk '$1 == "pid" && $2 == "=" { print $3; exit }'
}

job_running() {
  local p
  p=$(job_pid "$1")
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

# 阻断器改为直接 fork(见 `on` 分支注释),故按 PID 文件判断存活,
# 而非 launchd 任务。看门狗与提示条仍由 launchd 托管,沿用 job_running。
blocker_pid() { [[ -f "$PIDF" ]] && print -r -- "$(<$PIDF)" }
running() {
  local p=$(blocker_pid)
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

display_ids() {
  timeout 15 $BD get --identifiers 2>/dev/null | python3 -c '
import json, sys
try:
    objects = json.loads("[" + sys.stdin.read().strip() + "]")
except Exception:
    raise SystemExit(0)
for obj in objects:
    display_id = obj.get("displayID")
    if display_id:
        print(display_id)
' 2>/dev/null
}

valid_number() { [[ "$1" =~ '^[0-9]+([.][0-9]+)?$' ]] }

restore_file() {
  local source=$1 claim="${1}.restoring.$$" failed=0 i v
  [[ -f "$source" ]] || return 0
  mv "$source" "$claim" 2>/dev/null || return 0
  while read -r i v; do
    [[ -n "$i" && -n "$v" ]] || continue
    timeout 10 $BD set -displayID="$i" -brightness="$v" >/dev/null 2>&1 || failed=1
  done < "$claim"
  if (( failed )); then
    mv "$claim" "$source"
    return 1
  fi
  rm -f "$claim"
}

undim() { restore_file "$LUMF" }

restore_orphans() {
  local orphan failed=0
  for orphan in ${LUMF}.restoring.*(N); do
    restore_file "$orphan" || failed=1
  done
  return $failed
}

dim() {
  local tmp ids i current after
  [[ ! -f "$LUMF" ]] || {
    print -u2 "发现未完成的亮度恢复记录，请先运行 curtain off。"
    return 1
  }
  command -v $BD >/dev/null 2>&1 || {
    print -u2 "未找到 betterdisplaycli；拒绝启用，以免出现亮屏但输入被阻断。"
    return 1
  }
  tmp=$(mktemp "$STATE/brightness.XXXXXX") || return 1
  ids=(${(f)"$(display_ids)"})
  if (( ${#ids} == 0 )); then
    rm -f "$tmp"
    print -u2 "未发现可由 BetterDisplay 控制的显示器；未启用幕帘。"
    return 1
  fi
  for i in $ids; do
    current=$(timeout 10 $BD get -displayID="$i" -brightness 2>/dev/null | tr -d '\n')
    if ! valid_number "$current"; then
      print -u2 "无法读取 displayID=$i 的亮度；正在回滚。"
      mv "$tmp" "$LUMF"
      undim
      return 1
    fi
    print -r -- "$i $current" >> "$tmp"
    if ! timeout 10 $BD set -displayID="$i" -brightness=0 >/dev/null 2>&1; then
      print -u2 "无法调暗 displayID=$i；正在回滚。"
      mv "$tmp" "$LUMF"
      undim
      return 1
    fi
    after=$(timeout 10 $BD get -displayID="$i" -brightness 2>/dev/null | tr -d '\n')
    if ! valid_number "$after" || ! awk -v value="$after" 'BEGIN { exit !(value + 0 <= 0.01) }'; then
      print -u2 "displayID=$i 调暗后读回失败（brightness=$after）；正在回滚。"
      mv "$tmp" "$LUMF"
      undim
      return 1
    fi
  done
  mv "$tmp" "$LUMF"
}

wait_for_job() {
  local label=$1 p n=0
  while (( n < 30 )); do
    p=$(job_pid "$label")
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then
      print -r -- "$p"
      return 0
    fi
    sleep 0.1
    (( n += 1 ))
  done
  return 1
}

wait_for_watcher() {
  local n=0
  while job_running "$JOB_WATCHER" && (( n < 150 )); do
    sleep 0.1
    (( n += 1 ))
  done
  ! job_running "$JOB_WATCHER"
}

stop_jobs() {
  launchctl remove "$JOB_BLOCKER" 2>/dev/null || true
  launchctl remove "$JOB_BANNER" 2>/dev/null || true
}

case "${1:-status}" in
  on)
    shift
    secs=315360000
    secs_set=false
    allow_any=false
    while (( $# > 0 )); do
      case "$1" in
        --allow-any-injected) allow_any=true ;;
        <->)
          if $secs_set || (( $1 <= 0 )); then usage; exit 2; fi
          secs=$1
          secs_set=true
          ;;
        *) usage; exit 2 ;;
      esac
      shift
    done

    if running; then
      print "已在生效中 (pid $(blocker_pid))"
      exit 0
    fi
    orphan_restores=(${LUMF}.restoring.*(N))
    if job_running "$JOB_WATCHER" || (( ${#orphan_restores} > 0 )); then
      print -u2 "发现亮度恢复仍在进行，请先运行 curtain off。"
      exit 1
    fi
    for executable in "$BLOCKER" "$BANNER" "$WATCHER"; do
      [[ -x "$executable" ]] || { print -u2 "缺少可执行文件: $executable（请重新安装）"; exit 1; }
    done

    # 先验授权,再调暗。否则失败路径是「四块屏黑掉 → 阻断器起不来 → 回滚」,
    # 而回滚本身也可能失败。2026-09-02 的事故就走了这条路。
    if ! ax_trusted; then
      print -u2 "当前调用链没有辅助功能授权，阻断器起不来；未调暗、未启用幕帘。"
      print -u2 "TCC 归责的是这条链上最外层的 app（见 README 5.4）:"
      responsible_chain >&2
      print -u2 "对策：改从已授权的 Terminal.app 执行 curtain on。"
      print -u2 "注意 agent 会话（Claude Code / Codex 等）的责任 app 是随版本变化的"
      print -u2 "helper bundle，自动升级后正在运行的会话会整体失去授权。"
      record_run "ARM-DENIED 无辅助功能授权"
      exit 1
    fi

    allow=()
    [[ -f "$CONF" ]] && allow=(${(f)"$(grep -vE '^\s*(#|$)' "$CONF")"})
    deny=()
    if [[ -f "$DENY" ]]; then
      for d in ${(f)"$(grep -vE '^\s*(#|$)' "$DENY")"}; do deny+=(--deny "$d"); done
    fi
    if $allow_any && (( ${#deny} == 0 )); then
      print -u2 "--allow-any-injected 需要非空拒绝名单；未启用幕帘。"
      exit 1
    fi

    blocker_args=("$secs")
    $allow_any && blocker_args+=(--allow-any-injected)
    blocker_args+=($allow $deny)

    dim || { record_run "ARM-FAILED 调暗失败"; exit 1; }
    rotate_log "$LOG"
    rotate_log "$WATCHLOG"
    launchctl remove "$JOB_BLOCKER" 2>/dev/null || true
    launchctl remove "$JOB_BANNER" 2>/dev/null || true
    launchctl remove "$JOB_WATCHER" 2>/dev/null || true
    # 直接 fork,而非 launchctl submit。
    # 权衡(2026-09-01):经 launchd 提交可让 ssh 远程 `curtain on` 生效,
    # 但那要求 hid-blocker 持有自己的辅助功能授权 —— 等于给一个能吞掉全部
    # 物理输入的二进制常驻授权,且任何能 ssh 进来的人都能启用它。权限过大。
    # 改为直接 fork:归责到调用方 shell,因此只有已授权的交互式终端
    # (本机 Terminal、远程桌面里的终端)能启用,ssh 直接启用不再可行。
    # `curtain off` 不受影响,任何终端都能执行。
    "$BLOCKER" $blocker_args > "$LOG" 2>&1 &
    bpid=$!
    sleep 1
    if ! kill -0 "$bpid" 2>/dev/null; then
      print -u2 "阻断器启动失败:"
      sed 's/^/  /' "$LOG" >&2
      stop_jobs
      undim
      record_run "ARM-FAILED 阻断器未启动"
      exit 1
    fi
    print -r -- "$bpid" > "$PIDF"

    launchctl submit -l "$JOB_WATCHER" -o "$WATCHLOG" -e "$WATCHLOG" -- \
      "$WATCHER" "$bpid" "$PIDF" "$LUMF" "$JOB_BANNER" "$BANPID" "$(command -v $BD)"
    if ! wait_for_job "$JOB_WATCHER" >/dev/null; then
      print -u2 "亮度恢复看门狗启动失败；已取消幕帘。"
      stop_jobs
      undim
      rm -f "$PIDF"
      exit 1
    fi

    banner_warning=""
    # 提示条同样直接 fork。经 launchctl submit 时进程会立刻退出
    # (拿不到 window server 连接),而 status 只查 launchd 任务存在与否,
    # 于是出现「报显示中但四块屏都扫不到横幅」的假阳性。
    "$BANNER" >/dev/null 2>&1 &
    banpid=$!
    sleep 1
    if kill -0 "$banpid" 2>/dev/null; then
      print -r -- "$banpid" > "$BANPID"
    else
      banner_warning="（警告：提示条未启动）"
      rm -f "$BANPID"
    fi

    sleep 1
    if ! running; then
      record_run "ARM-FAILED 阻断器未保持运行"
      print -u2 "阻断器未保持运行:"
      sed 's/^/  /' "$LOG" >&2
      stop_jobs
      if ! wait_for_watcher; then
        print -u2 "警告：看门狗未在 15 秒内结束，正在接管恢复。"
        launchctl remove "$JOB_WATCHER" 2>/dev/null || true
      fi
      undim
      restore_orphans
      rm -f "$PIDF" "$BANPID"
      exit 1
    fi
    # 「期望幕帘是拉上的」。curtain-sentry 靠这个标记判断幕帘是不是掉了;
    # 只有 curtain off(人明确要求解除)会清除它,看门狗不会。
    print -r -- "$(date '+%F %T')" > "$EXPECT"
    record_run "ON pid=$bpid secs=$secs"
    osascript -e 'display notification "物理键鼠已阻断 · Ctrl+Opt+Cmd+Shift+U 解除" with title "curtain 已启用"' >/dev/null 2>&1
    sed 's/^/  /' "$LOG"
    if (( secs > 100000000 )); then
      print "已生效。白名单 ${#allow} 项，无自动解除 $banner_warning"
    else
      print "已生效。白名单 ${#allow} 项，${secs} 秒后自动解除 $banner_warning"
    fi
    print "拉开方式（off 不需要辅助功能权限）:"
    print "  · UURemote → 终端 → curtain off"
    print "  · ssh <host> curtain off"
    print "  · 热键 Ctrl+Opt+Cmd+Shift+U（需真人按键验收）"
    ;;

  off)
    rm -f "$EXPECT"
    record_run "OFF 由 curtain off 解除"
    old_pid=""
    [[ -f "$PIDF" ]] && old_pid=$(<"$PIDF")
    launchctl remove "$JOB_BLOCKER" 2>/dev/null || true
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
      kill -TERM "$old_pid" 2>/dev/null || true
    fi
    if ! wait_for_watcher; then
      print -u2 "警告：看门狗未在 15 秒内结束，正在接管恢复。"
      launchctl remove "$JOB_WATCHER" 2>/dev/null || true
    fi
    undim || print -u2 "警告：部分显示器亮度恢复失败，备份仍保留在 $LUMF"
    restore_orphans || print -u2 "警告：孤立亮度恢复记录仍未完全处理。"
    launchctl remove "$JOB_BANNER" 2>/dev/null || true
    if [[ -f "$BANPID" ]]; then
      kill -TERM "$(<"$BANPID")" 2>/dev/null || true
    fi
    rm -f "$PIDF" "$BANPID"
    osascript -e 'display notification "已恢复正常" with title "curtain 已解除"' >/dev/null 2>&1
    tail -1 "$LOG" 2>/dev/null | sed 's/^/  /'
    print "已解除，亮度已恢复。"
    ;;

  status)
    if running; then
      print "阻断: 生效中 (pid $(blocker_pid))"
      head -1 "$LOG" 2>/dev/null | sed 's/^/  /'
    else
      print "阻断: 未生效"
      if ax_trusted; then
        print "  当前调用链有辅助功能授权，curtain on 可以执行。"
      else
        print "  当前调用链**没有**辅助功能授权，curtain on 会失败（见 doctor）。"
      fi
    fi
    if [[ -s "$LASTRUN" ]]; then
      print "最近记录:"
      tail -n 3 "$LASTRUN" | sed 's/^/  /'
    fi
    print -n "锁屏: "
    python3 -c '
import plistlib, subprocess
output = subprocess.run(["ioreg", "-n", "Root", "-d1", "-a"], capture_output=True).stdout
data = plistlib.loads(output)
root = data[0] if isinstance(data, list) else data
print(root.get("IOConsoleUsers", [{}])[0].get("CGSSessionScreenIsLocked", "False"))
' 2>/dev/null || print "?"
    if [[ -f "$BANPID" ]] && kill -0 "$(<$BANPID)" 2>/dev/null; then
      print "提示条: 显示中 (pid $(<$BANPID))"
    else print "提示条: 未显示"; fi
    if job_running "$JOB_WATCHER"; then print "看门狗: 生效中"; else print "看门狗: 未托管"; fi
    if [[ -f "$EXPECT" ]]; then
      print "期望: 拉上（$(cat "$EXPECT" 2>/dev/null) 起）"
    else
      print "期望: 无（最近一次是 curtain off）"
    fi
    if [[ -x "$SENTRY" ]] && launchctl print "gui/$(id -u)/$JOB_SENTRY" >/dev/null 2>&1; then
      print "看护: 已托管（$JOB_SENTRY）"
    else
      print "看护: 未托管 —— 幕帘掉了不会有人告诉你"
    fi
    print "白名单:"
    [[ -f "$CONF" ]] && grep -vE '^\s*(#|$)' "$CONF" | while read -r p; do
      print "  [$(pgrep -f "$p" 2>/dev/null | wc -l | tr -d ' ') 个进程] $p"
    done
    print "拒绝名单（优先级最高）:"
    [[ -f "$DENY" ]] && grep -vE '^\s*(#|$)' "$DENY" | while read -r d; do
      print "  [$(pgrep -f "$d" 2>/dev/null | wc -l | tr -d ' ') 个进程] ${d:t}"
    done
    print "显示器:"
    for i in ${(f)"$(display_ids)"}; do
      print "  displayID=$i brightness=$(timeout 10 $BD get -displayID=$i -brightness 2>/dev/null | tr -d '\n')"
    done
    ;;

  doctor)
    failures=0
    for command_name in swiftc betterdisplaycli timeout launchctl python3; do
      if command -v "$command_name" >/dev/null 2>&1; then
        print "[ok] $command_name=$(command -v "$command_name")"
      else
        print "[fail] 缺少 $command_name"
        failures=1
      fi
    done
    for executable in "$BLOCKER" "$BANNER" "$WATCHER" "$SENTRY"; do
      if [[ -x "$executable" ]]; then print "[ok] $executable"; else print "[fail] $executable"; failures=1; fi
    done
    if launchctl print "gui/$(id -u)/$JOB_SENTRY" >/dev/null 2>&1; then
      print "[ok] 看护已托管 $JOB_SENTRY"
    else
      print "[warn] 看护未托管 —— 幕帘掉了不会有人告诉你（重跑 install.sh）"
    fi
    if [[ -f "$DENY" ]] && [[ -n "$(grep -vE '^\s*(#|$)' "$DENY")" ]]; then
      print "[ok] 拒绝名单已配置"
    else
      print "[fail] 拒绝名单缺失或为空"
      failures=1
    fi
    ids=(${(f)"$(display_ids)"})
    if (( ${#ids} > 0 )); then print "[ok] BetterDisplay 发现 ${#ids} 块显示器"; else print "[fail] 未发现显示器"; failures=1; fi

    # 唯一会让 `on` 失败、而其余检查都发现不了的东西。
    if ax_trusted; then
      print "[ok] 辅助功能授权（当前调用链）"
    else
      print "[fail] 当前调用链没有辅助功能授权 —— curtain on 必失败"
      failures=1
    fi
    print "[info] TCC 归责链（认最外层那个 .app）:"
    responsible_chain

    for executable in "$BLOCKER" "$BANNER" "$WATCHER" "$SENTRY"; do
      [[ -x "$executable" ]] || continue
      [[ "$executable" == *.sh || -z "$(file -b "$executable" | grep -i mach-o)" ]] && continue
      if adhoc_signed "$executable"; then
        print "[warn] ${executable:t} 是 ad-hoc 签名 —— 多半是就地 swiftc 编出来的，"
        print "       与仓库 build/ 不一致，且重编后 TCC 授权必然失效。重跑 install.sh。"
      fi
    done

    if [[ -f "$MANIFEST" ]]; then
      drifted=0
      while read -r recorded_hash recorded_path; do
        [[ -n "$recorded_hash" && -n "$recorded_path" ]] || continue
        current_hash=$(shasum -a 256 "$recorded_path" 2>/dev/null | awk '{print $1}')
        if [[ "$current_hash" != "$recorded_hash" ]]; then
          print "[warn] 与安装时不一致: $recorded_path"
          drifted=1
        fi
      done < "$MANIFEST"
      (( drifted )) || print "[ok] 安装物与 install.sh 记录一致"
    else
      print "[warn] 没有安装清单 $MANIFEST —— 用 install.sh 重装以生成"
    fi

    if [[ -x "$BLOCKER" ]]; then
      signature=$(codesign -dvv "$BLOCKER" 2>&1 | awk -F= '/^Authority=|^Signature=/{print $2; exit}')
      [[ -n "$signature" ]] && print "[info] hid-blocker 签名: $signature"
      # 路径型 TCC 条目钉的是 cdhash,重新编译/重新签名后就失配 ——
      # 条目还在系统设置里显示为「已勾选」,但对当前二进制无效。
      # csreq 里 cdhash 是 20 个裸字节,得用 csreq(1) 反解成文本才读得出来。
      pinned=$(sudo -n sqlite3 "/Library/Application Support/com.apple.TCC/TCC.db" \
        "select hex(csreq) from access where service='kTCCServiceAccessibility' and client='$BLOCKER';" 2>/dev/null |
        xxd -r -p 2>/dev/null | csreq -r- -t 2>/dev/null |
        sed -n 's/.*cdhash H"\([0-9a-f]*\)".*/\1/p' | head -1)
      if [[ -n "$pinned" ]]; then
        current_cdhash=$(codesign -d --verbose=4 "$BLOCKER" 2>&1 | awk -F= '/^CDHash=/{print $2; exit}')
        if [[ "$pinned" == "$current_cdhash" ]]; then
          print "[ok] hid-blocker 自身的 TCC 条目匹配当前二进制"
        else
          print "[warn] hid-blocker 自身的 TCC 条目钉在旧 cdhash 上（$pinned"
          print "       ≠ $current_cdhash）—— 条目虽在，对当前二进制无效。"
          print "       修法：系统设置 > 隐私与安全性 > 辅助功能，「−」删掉再「+」加回。"
          print "       只影响 launchd / 热键这类以 hid-blocker 自身为责任进程的启动路径。"
        fi
      fi
    fi
    exit $failures
    ;;

  allow) ${EDITOR:-vi} "$CONF" ;;
  deny)  ${EDITOR:-vi} "$DENY" ;;
  *) usage; exit 2 ;;
esac
