#!/bin/zsh
# launchd 托管的恢复看门狗。阻断器无论正常退出、超时或崩溃，均恢复亮度。
set -eu
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH

if (( $# != 6 )); then
  print -u2 "usage: curtain-watchdog <blocker-pid> <pid-file> <brightness-file> <banner-job> <banner-pid-file> <betterdisplaycli>"
  exit 2
fi

blocker_pid=$1
pid_file=$2
brightness_file=$3
banner_job=$4
banner_pid_file=$5
betterdisplay=$6

while kill -0 "$blocker_pid" 2>/dev/null; do sleep 2; done

claim="${brightness_file}.restoring.$$"
failed=0
if mv "$brightness_file" "$claim" 2>/dev/null; then
  while read -r display_id value; do
    [[ -n "$display_id" && -n "$value" ]] || continue
    timeout 10 "$betterdisplay" set -displayID="$display_id" -brightness="$value" >/dev/null 2>&1 || failed=1
  done < "$claim"
  if (( failed )); then
    mv "$claim" "$brightness_file"
    print -u2 "亮度恢复不完整；备份保留在 $brightness_file"
  else
    rm -f "$claim"
  fi
fi

launchctl remove "$banner_job" 2>/dev/null || true
if [[ -f "$banner_pid_file" ]]; then
  kill -TERM "$(<"$banner_pid_file")" 2>/dev/null || true
fi
rm -f "$pid_file" "$banner_pid_file"
if [[ "${CURTAIN_WATCHDOG_NOTIFY:-1}" == 1 ]]; then
  osascript -e 'display notification "已自动解除" with title "curtain"' >/dev/null 2>&1 || true
fi
print "RESTORED blocker=$blocker_pid failed=$failed"
exit $failed
